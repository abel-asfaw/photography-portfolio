    "@tanstack/react-query": "^5.80.7",
    "axios": "^1.13.2",
    "classnames": "^2.5.1",
    "motion": "^12.33.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-feather": "^2.0.10",
    "react-router-dom": "^7.6.2",
