{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "functions": ["classNames"]
  },
  "sortImports": {
    "internalPattern": ["@/"]
  },
  "ignorePatterns": ["dist", "public", "package-lock.json"]
}
